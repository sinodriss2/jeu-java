    // PERSONNAGE 
    public static class Personnage {
        String nom;
        int argentDisponible;
        HashMap<String, Integer> inventaireGraines; // nom graine → quantité
        HashMap<String, Integer> inventaireRecolte; // nom légume → quantité

        public Personnage(String nom, int argentDisponible) {
            this.nom = nom;
            this.argentDisponible = argentDisponible;
            this.inventaireGraines = new HashMap<>();
            this.inventaireRecolte = new HashMap<>();
        }

        public void ajouterArgent(int montant) { if (montant > 0) argentDisponible += montant; }
        public boolean peutAcheter(int prix) { return argentDisponible >= prix; }
        public void depenserArgent(int montant) { if (montant <= argentDisponible) argentDisponible -= montant; }

        public void ajouterGraine(String nom, int qte) {
            inventaireGraines.put(nom, inventaireGraines.getOrDefault(nom,0)+qte);
        }

        public void ajouterRecolte(String nom, int qte){
            inventaireRecolte.put(nom, inventaireRecolte.getOrDefault(nom,0)+qte);
        }
    }

    //  PRODUIT 
    public static class Produit {
        String Name;
        int PrixAchat;
        public Produit(String name, int PA){ Name=name; PrixAchat=PA; }

        public boolean acheterGraine(Personnage p){
            if(p.peutAcheter(PrixAchat)){
                p.depenserArgent(PrixAchat);
                p.ajouterGraine(Name,1);
                return true;
            }
            return false;
        }
    }
    
    // PRODUIT MARCHE VENTE 
    
    public static class ProduitMarche{
    	String name;
    	int prixAchat;
    	int prixBaseAchat;
    	int prixVente;
    	int prixBaseVente;
    	int stock;
    	int achatsRecents;
    	int ventesRecentes;
    	int prixMin;
    	int prixMax;
    	
    	public ProduitMarche(String name, int pa, int pba, int pv, int pbv) {
    		this.name = name;
    		this.prixAchat = pa;
    		this.prixBaseAchat = pba; 
    		this.prixBaseVente = pbv;
    		this.prixVente = pbv; 
    		this.stock = 500;
    		this.achatsRecents = 0;
    		this.ventesRecentes = 0;
    		
    		this.prixMin =(int)(prixBaseVente * 0.25); 
    		this.prixMax = prixBaseAchat * 4; 
    		
    	}
    	
    	public void mettreAJourPrix() {
    		double facteurDemande = 1 + (10.0 * achatsRecents / (stock + 1));
    		double facteurOffre = 1 - (5.0 * ventesRecentes / (stock + 1));
    		
    		facteurOffre = Math.max(facteurOffre, 0.25);
    		facteurDemande = Math.min(facteurDemande, 4.0);  		
    		
    		prixAchat = (int)(prixBaseAchat * facteurDemande);
    		prixVente = (int)(prixBaseVente * facteurOffre);
    		
    		if (prixAchat > prixMax) prixAchat = prixMax;
    		if (prixVente < prixMin) prixVente = prixMin; 
    	}
    	
    }
    // fenetre de vente 
    private void ouvrirFenetreVente() {
    	JDialog vente = new JDialog((Frame) null, "Vente", true);
    	vente.setSize(300,300);
    	vente.setLayout(new BoxLayout(vente.getContentPane(), BoxLayout.Y_AXIS));
    	
    	vente.add(new JLabel("Que veux-tu vendre"));
    	
    	for (String nom : joueur.inventaireRecolte.keySet()) {
    		int qte = joueur.inventaireRecolte.get(nom);
    		if (qte <= 0) continue; 
    		
    		ProduitMarche pm = null; 
    		if (nom.equals("Blé")) pm = marcheBle;
    		if (nom.equals("Maïs")) pm = marcheMais;
    		if (nom.equals("Patate")) pm = marchePatate; 
    		
    		if (pm == null) continue; 
    		
    		JButton b = new JButton(nom + "(" + qte + ") - " + pm.prixVente + "G" );
    		ProduitMarche finalPM = pm;
    		b.addActionListener(e -> {
    			vendreProduit(nom, finalPM);
    			vente.dispose();
    		});
    		
    		vente.add(b);
    	}
    	vente.setVisible(true);
    	
    }
    
    // vendre le produit 
    private void vendreProduit(String nom, ProduitMarche produit) {
        Integer qte = joueur.inventaireRecolte.get(nom);
        if (qte == null || qte <= 0) {
            afficherMessage( "Tu n'as pas de " + nom + " à vendre !");
            return;
        }
        joueur.inventaireRecolte.put(nom, qte - 1);
        int montant = produit.prixVente;
        joueur.ajouterArgent(montant);
        labelArgent.setText(joueur.argentDisponible + " G");
        produit.ventesRecentes += 1;
        produit.stock -= 1;
        produit.mettreAJourPrix();
        repaint();
        afficherMessage( nom + " vendu pour " + montant + " G !");
    }


    // CHAMP 
    public static class CHAMP {
        public enum Etat {HERBE, TERREBATTUE, TERREPRETE, PLANTE}
        public class Zone {
            public int xCZ, yCZ;
            public Etat etat = Etat.HERBE;
            public boolean arrose=false;
            public String culture=null; 
            public Zone(int x, int y){ xCZ=x; yCZ=y; }
            public Rectangle getBounds(){ return new Rectangle(xCZ,yCZ,50,50);}
        }

        public ArrayList<Zone> zones;
        public Image imgHerbe, imgTerreBattue, imgTerrePrete, imgPlante;

        public CHAMP(int largeur, int hauteur, int startX, int startY){
            zones = new ArrayList<>();
            for(int i=0;i<largeur;i++){
                for(int j=0;j<hauteur;j++){
                    zones.add(new Zone(startX + i*50, startY + j*50));
                }
            }
            imgHerbe = new ImageIcon("images/Herbe.png").getImage();
            imgTerreBattue = new ImageIcon("images/TerreBattue.png").getImage();
            imgTerrePrete = new ImageIcon("images/TerrePrête.png").getImage();
            imgPlante = new ImageIcon("images/Plante.png").getImage(); 
        }

        public Zone getZoneSousJoueur(double x, double y){
            for(Zone z : zones) if(z.getBounds().contains(x,y)) return z;
            return null;
        }

        public void dessiner(Graphics2D g2){
            for(Zone z : zones){
                switch(z.etat){
                    case HERBE: g2.drawImage(imgHerbe, z.xCZ, z.yCZ,50,50,null); break;
                    case TERREBATTUE: g2.drawImage(imgTerreBattue, z.xCZ, z.yCZ,50,50,null); break;
                    case TERREPRETE: g2.drawImage(imgTerrePrete, z.xCZ, z.yCZ,50,50,null); break;
                    case PLANTE: g2.drawImage(imgPlante, z.xCZ, z.yCZ,50,50,null); break;
                }
                if(z.arrose && z.etat==Etat.PLANTE){
                    g2.setColor(new Color(0,0,255,80));
                    g2.fillRect(z.xCZ,z.yCZ,50,50);
                }
                g2.setColor(Color.BLACK);
                g2.drawRect(z.xCZ,z.yCZ,50,50);
            }
        }
    }

