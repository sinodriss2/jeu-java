    //  MOVE ACTION 
    private class MoveAction extends AbstractAction{
        private final int dx, dy; private final Direct newDir;
        public MoveAction(int dx,int dy,Direct dir){ this.dx=dx; this.dy=dy; this.newDir=dir; }
        public void actionPerformed(ActionEvent e){
            int newX = (int)Math.max(0,Math.min(targetX+dx,WIDTH-SIZE));
            int newY = (int)Math.max(0,Math.min(targetY+dy,HEIGHT-SIZE));
            Rectangle futur = new Rectangle(newX,newY,SIZE,SIZE);
            if(!futur.intersects(zoneInventaire) && !futur.intersects(zoneBarreOutils)){
                targetX=newX; targetY=newY;
            }
            direction=newDir;
            switch(direction){ case UP: angleB=-90; break; case DOWN: angleB=90; break; case LEFT: angleB=180; break; case RIGHT: angleB=0; break;}
            
            if (direction == Direct.UP || direction == Direct.LEFT) {
            	jouerSon("sons/pas.wav");
                    }else if (direction == Direct.DOWN || direction == Direct.RIGHT) {
                    	jouerSon("sons/pas.wav");
                    }
            repaint();
        }
    }

    // PAINT COMPONENT
    @Override
    protected void paintComponent(Graphics g){
        super.paintComponent(g);
        Graphics2D g2 = (Graphics2D) g;

        // Fond interface
        g2.setColor(new Color(144,200,180));
        g2.fill(zoneInventaire);
        g2.setColor(new Color(204,150,0));
        g2.fill(zoneBarreOutils);

        // Dessiner le champ
        champ.dessiner(g2);

        // Dessiner personnage
        Image currentImg = persoFace;
        if(direction==Direct.LEFT) currentImg=persoGauche;
        else if(direction==Direct.RIGHT) currentImg=persoDroite;
        AffineTransform old = g2.getTransform();
        g2.translate(x,y);
        if(currentImg!=null) g2.drawImage(currentImg,-SIZE/2,-SIZE/2,SIZE,SIZE,this);
        g2.setTransform(old);

        // Dessiner inventaire (quantités)
        int yInv = 20;
        g2.setColor(Color.BLACK);
        g2.setFont(new Font("Arial",Font.BOLD,14));
        g2.drawString("Graines :",810,yInv);
        yInv+=20;
        for(String nom : joueur.inventaireGraines.keySet()){
            g2.drawString(nom + " : "+joueur.inventaireGraines.get(nom),810,yInv);
            yInv+=20;
        }
        g2.drawString("Récoltes :",810,yInv); yInv+=20;
        for(String nom : joueur.inventaireRecolte.keySet()){
            g2.drawString(nom + " : "+joueur.inventaireRecolte.get(nom),810,yInv);
            yInv+=20;
        }
    }

    private JButton createImageButton(String path,int maxWidth,int maxHeight){
        ImageIcon icon = new ImageIcon(path);
        Image img = icon.getImage();
        double scale = Math.min((double)maxWidth/img.getWidth(null),(double)maxHeight/img.getHeight(null));
        int newW = (int)(img.getWidth(null)*scale);
        int newH = (int)(img.getHeight(null)*scale);
        Image scaled = img.getScaledInstance(newW,newH,Image.SCALE_SMOOTH);
        JButton button = new JButton(new ImageIcon(scaled));
        button.setBorderPainted(false); button.setContentAreaFilled(false);
        button.setFocusPainted(false); button.setOpaque(false);
        button.setSize(newW,newH);
        return button;
    }

