    private Clip clipMusique;

    private void jouerSon(String cheminFichier) {
        try {
            AudioInputStream audioIn = AudioSystem.getAudioInputStream(new File(cheminFichier));
            Clip clip = AudioSystem.getClip();
            clip.open(audioIn);
            clip.start();
        } catch (UnsupportedAudioFileException | IOException | LineUnavailableException e) {
            e.printStackTrace();
        }
    }

    private void jouerMusique(String cheminFichier) {
        try {
            AudioInputStream audioIn = AudioSystem.getAudioInputStream(new File(cheminFichier));
            clipMusique = AudioSystem.getClip();
            clipMusique.open(audioIn);
            clipMusique.loop(Clip.LOOP_CONTINUOUSLY);
            clipMusique.start();
        } catch (Exception e) {
            e.printStackTrace();
        }
    }

    private void arreterMusique() {
        if (clipMusique != null) {
            clipMusique.stop();
            clipMusique.close();
        }
    }
    
